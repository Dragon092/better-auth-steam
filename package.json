{
  "name": "better-auth-steam",
  "version": "1.0.0",
  "description": "Steam authentication plugin for better-auth",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "pnpm build"
  },
  "keywords": [
    "better-auth",
    "steam",
    "auth"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@better-fetch/fetch": "^1.3.2",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
